<Application x:Class="PlcScope.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111827" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="AppPanelAltBrush" Color="#243244" />
    <SolidColorBrush x:Key="AppHeaderBrush" Color="#172033" />
    <SolidColorBrush x:Key="AppInputBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="AppInputDisabledBrush" Color="#1A2232" />
    <SolidColorBrush x:Key="AppHoverBrush" Color="#334155" />
    <SolidColorBrush x:Key="AppPressedBrush" Color="#0B1120" />
    <SolidColorBrush x:Key="AppDropdownBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#374151" />
    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#263244" />
    <SolidColorBrush x:Key="AppBorderDisabledBrush" Color="#283241" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="AppForegroundStrongBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="AppForegroundMutedBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AppAccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#1E3A8A" />
    <SolidColorBrush x:Key="AppRowHoverBrush" Color="#27364A" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="AppSuccessSoftBrush" Color="#12351F" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AppWarningSoftBrush" Color="#3A2605" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AppDangerSoftBrush" Color="#3B1618" />
    <SolidColorBrush x:Key="AppAddressBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="AppValueBrush" Color="#FDE68A" />
    <SolidColorBrush x:Key="AppHexBrush" Color="#F97316" />
    <SolidColorBrush x:Key="AppCommentBrush" Color="#86EFAC" />
    <SolidColorBrush x:Key="AppBitOffBrush" Color="#182235" />
    <SolidColorBrush x:Key="AppBitOffBorderBrush" Color="#475569" />
    <SolidColorBrush x:Key="AppWriteInputBrush" Color="#102A43" />

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0F172A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F9FAFB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9CA3AF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#111827" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F9FAFB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1F2937" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F9FAFB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1E3A8A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F9FAFB" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1E3A8A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#E5E7EB" />

    <Style TargetType="{x:Type TextBlock}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="FieldLabelTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="3"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppAccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AppInputDisabledBrush}" />
                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AppBorderDisabledBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
    </Style>

    <Style x:Key="WarningButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CaretBrush" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource AppSelectionBrush}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{DynamicResource AppInputDisabledBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppBorderDisabledBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type PasswordBox}">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="{DynamicResource AppInputDisabledBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppBorderDisabledBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid>
              <Border x:Name="ComboBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="3"
                      SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>

                  <ContentPresenter Margin="8,0,4,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />

                  <Border x:Name="DropDownGlyphHost"
                          Grid.Column="1"
                          Background="{DynamicResource AppHeaderBrush}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="1,0,0,0">
                    <Path Width="10"
                          Height="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="{TemplateBinding Foreground}"
                          Data="M 0 0 L 10 0 L 5 6 Z" />
                  </Border>
                </Grid>
              </Border>

              <ToggleButton Background="Transparent"
                            BorderThickness="0"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     AllowsTransparency="True"
                     Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        Margin="0,2,0,0"
                        Background="{DynamicResource AppPanelBrush}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="DropDownGlyphHost" Property="Background" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                <Setter TargetName="DropDownGlyphHost" Property="Background" Value="{DynamicResource AppAccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource AppInputDisabledBrush}" />
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource AppBorderDisabledBrush}" />
                <Setter TargetName="DropDownGlyphHost" Property="Background" Value="{DynamicResource AppHeaderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="Padding" Value="8,5" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type GroupBox}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style TargetType="{x:Type Menu}">
      <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
      <Setter Property="Padding" Value="10,5" />
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type StatusBar}">
      <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type ListBox}">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource AppBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AppSelectionBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="Background" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
      <Setter Property="RowBackground" Value="{DynamicResource AppInputBrush}" />
      <Setter Property="AlternatingRowBackground" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
    </Style>

    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="{DynamicResource AppHeaderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
