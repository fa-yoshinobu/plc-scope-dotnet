<Window x:Class="PlcScope.App.Windows.TraceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通信ログ"
        Width="1100"
        Height="700"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
  <Grid Margin="12">
    <DataGrid ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#252526"
              Foreground="#E0E0E0"
              RowBackground="#1F1F1F"
              AlternatingRowBackground="#252526">
      <DataGrid.Columns>
        <DataGridTextColumn Header="時刻" Binding="{Binding Timestamp}" Width="180" />
        <DataGridTextColumn Header="プロトコル" Binding="{Binding Protocol}" Width="120" />
        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="100" />
        <DataGridTextColumn Header="概要" Binding="{Binding Summary}" Width="180" />
        <DataGridTextColumn Header="ペイロード" Binding="{Binding PayloadHex}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
