<Window x:Class="PlcScope.App.Windows.TraceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Communication log"
        Width="920"
        Height="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
      <Button Content="Copy selected" Click="CopySelectedButton_Click" Padding="10,4" Margin="0,0,6,0" />
      <Button Content="Copy all" Click="CopyAllButton_Click" Padding="10,4" Margin="0,0,6,0" />
      <Button Content="Clear history" Click="ClearHistoryButton_Click" Padding="10,4" />
    </StackPanel>
    <DataGrid x:Name="TraceDataGrid"
              ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              ClipboardCopyMode="IncludeHeader"
              CanUserAddRows="False">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Copy selected" Click="CopySelectedButton_Click" />
          <MenuItem Header="Copy all" Click="CopyAllButton_Click" />
          <MenuItem Header="Clear history" Click="ClearHistoryButton_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180" />
        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="120" />
        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="100" />
        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="180" />
        <DataGridTextColumn Header="Payload" Binding="{Binding PayloadHex}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
