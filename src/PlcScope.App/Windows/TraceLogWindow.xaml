<Window x:Class="PlcScope.App.Windows.TraceLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通信ログ"
        Width="1100"
        Height="700"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="選択コピー" Click="CopySelectedButton_Click" Padding="10,4" Margin="0,0,6,0" />
      <Button Content="全コピー" Click="CopyAllButton_Click" Padding="10,4" Margin="0,0,6,0" />
      <Button Content="履歴削除" Click="ClearHistoryButton_Click" Padding="10,4" />
    </StackPanel>

    <DataGrid x:Name="TraceDataGrid"
              ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              ClipboardCopyMode="IncludeHeader">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="選択コピー" Click="CopySelectedButton_Click" />
          <MenuItem Header="全コピー" Click="CopyAllButton_Click" />
          <Separator />
          <MenuItem Header="履歴削除" Click="ClearHistoryButton_Click" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="時刻" Binding="{Binding Timestamp}" Width="180" />
        <DataGridTextColumn Header="プロトコル" Binding="{Binding Protocol}" Width="120" />
        <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="100" />
        <DataGridTextColumn Header="概要" Binding="{Binding Summary}" Width="180" />
        <DataGridTextColumn Header="ペイロード" Binding="{Binding PayloadHex}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
