<Window x:Class="PlcScope.App.Windows.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="パスワード"
        Width="360"
        Height="170"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="OK" Width="90" Margin="0,0,8,0" Click="OkButton_Click" Style="{StaticResource AccentButtonStyle}" />
      <Button Content="キャンセル" Width="90" IsCancel="True" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="必要な場合のみリモートパスワードを入力してください。" Margin="0,0,0,8" />
      <PasswordBox x:Name="PasswordBox" />
    </StackPanel>
  </DockPanel>
</Window>
