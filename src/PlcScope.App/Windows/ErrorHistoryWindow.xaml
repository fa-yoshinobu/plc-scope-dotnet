<Window x:Class="PlcScope.App.Windows.ErrorHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エラー履歴"
        Width="1000"
        Height="640"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
  <Grid Margin="12">
    <DataGrid ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Background="#252526"
              Foreground="#E0E0E0"
              RowBackground="#1F1F1F"
              AlternatingRowBackground="#252526">
      <DataGrid.Columns>
        <DataGridTextColumn Header="時刻" Binding="{Binding Timestamp}" Width="180" />
        <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="160" />
        <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="260" />
        <DataGridTextColumn Header="詳細" Binding="{Binding Details}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
