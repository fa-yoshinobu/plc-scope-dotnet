<Window x:Class="PlcScope.App.Windows.ErrorHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="エラー履歴"
        Width="1000"
        Height="640"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <Grid Margin="12">
    <DataGrid ItemsSource="{Binding}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="時刻" Binding="{Binding Timestamp}" Width="180" />
        <DataGridTextColumn Header="操作" Binding="{Binding Operation}" Width="160" />
        <DataGridTextColumn Header="メッセージ" Binding="{Binding Message}" Width="260" />
        <DataGridTextColumn Header="詳細" Binding="{Binding Details}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>
