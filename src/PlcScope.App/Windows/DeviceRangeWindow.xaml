<Window x:Class="PlcScope.App.Windows.DeviceRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="デバイス範囲"
        Width="1100"
        Height="700"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="{Binding ModelText}" Margin="0,0,18,0" FontWeight="SemiBold" />
      <TextBlock Text="{Binding FamilyText}" Foreground="{DynamicResource AppForegroundMutedBrush}" />
    </StackPanel>

    <DataGrid ItemsSource="{Binding Entries}"
              AutoGenerateColumns="False"
              IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="デバイス" Binding="{Binding Device}" Width="90" />
        <DataGridTextColumn Header="種別" Binding="{Binding Category}" Width="120" />
        <DataGridCheckBoxColumn Header="Bit" Binding="{Binding IsBitDevice}" Width="60" />
        <DataGridCheckBoxColumn Header="対応" Binding="{Binding Supported}" Width="70" />
        <DataGridTextColumn Header="点数" Binding="{Binding PointCount}" Width="90" />
        <DataGridTextColumn Header="下限" Binding="{Binding LowerBound}" Width="80" />
        <DataGridTextColumn Header="上限" Binding="{Binding UpperBound}" Width="90" />
        <DataGridTextColumn Header="範囲" Binding="{Binding AddressRange}" Width="170" />
        <DataGridTextColumn Header="表記" Binding="{Binding Notation}" Width="90" />
        <DataGridTextColumn Header="ソース" Binding="{Binding Source}" Width="150" />
        <DataGridTextColumn Header="備考" Binding="{Binding Notes}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
