<Window x:Class="PlcScope.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="バージョン情報"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <Grid Margin="20">
    <StackPanel>
      <TextBlock Text="PLC I/O モニター" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AppForegroundStrongBrush}" Margin="0,0,0,12" />
      <TextBlock Text="SLMP / Host Link / TOYOPUC Computer Link に対応した Windows デスクトップモニターです。" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text=".NET 9 / WPF" Foreground="{DynamicResource AppValueBrush}" Margin="0,0,0,4" />
      <TextBlock Text="配布ターゲット: framework-dependent / win-x64" Foreground="{DynamicResource AppForegroundMutedBrush}" />
    </StackPanel>
  </Grid>
</Window>
