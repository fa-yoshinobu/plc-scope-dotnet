<Window x:Class="PlcScope.App.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connection settings"
        Width="760"
        Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,12,0,0">
      <Button Content="OK" AutomationProperties.AutomationId="ConnectionDialogOkButton" Width="100" Margin="0,0,8,0" Click="OkButton_Click" Style="{StaticResource AccentButtonStyle}" />
      <Button Content="Cancel" AutomationProperties.AutomationId="ConnectionDialogCancelButton" Width="100" IsCancel="True" />
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,16,0">
        <GroupBox Header="Common" Margin="0,0,0,12">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Protocol" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      AutomationProperties.AutomationId="ConnectionProtocolComboBox"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding Protocols}"
                      DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedProtocol}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Transport" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      AutomationProperties.AutomationId="ConnectionTransportComboBox"
                      Width="160"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding TransportModes}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedTransportMode}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Host" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="ConnectionHostTextBox" Margin="0,0,0,8" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Port" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="3" Grid.Column="1" AutomationProperties.AutomationId="ConnectionPortTextBox" Margin="0,0,0,8" Text="{Binding Port}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Timeout (s)" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="ConnectionTimeoutSecondsTextBox" Width="120" Margin="0,0,0,8" Text="{Binding TimeoutSeconds}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Refresh interval ms" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Grid.Row="5" Grid.Column="1" AutomationProperties.AutomationId="ConnectionRefreshIntervalTextBox" Width="120" Text="{Binding AutoRefreshIntervalMs}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="SLMP" Visibility="{Binding IsSlmpSelected, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC profile" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      AutomationProperties.AutomationId="ConnectionSlmpProfileComboBox"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding SlmpProfiles}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedSlmpProfile}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Network" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="ConnectionSlmpNetworkTextBox" Margin="0,0,0,8" Text="{Binding SlmpNetworkText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Station" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="ConnectionSlmpStationTextBox" Margin="0,0,0,8" Text="{Binding SlmpStationText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Module I/O" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="3" Grid.Column="1"
                      AutomationProperties.AutomationId="ConnectionSlmpModuleIoComboBox"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding SlmpModuleIoTargets}"
                      SelectedItem="{Binding SlmpModuleIo}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Multidrop" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="4" Grid.Column="1" AutomationProperties.AutomationId="ConnectionSlmpMultidropTextBox" Margin="0,0,0,8" Text="{Binding SlmpMultidropText, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Row="5"
                    Grid.Column="1"
                    Content="Reset routing defaults"
                    AutomationProperties.AutomationId="ConnectionSlmpResetRoutingDefaultsButton"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    Padding="10,4"
                    Click="ResetSlmpRoutingDefaultsButton_Click" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Monitoring timer" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="6" Grid.Column="1" AutomationProperties.AutomationId="ConnectionSlmpMonitoringTimerTextBox" Margin="0,0,0,8" Text="{Binding SlmpMonitoringTimer}" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Remote password" VerticalAlignment="Center" Margin="0,0,8,0" />
            <PasswordBox x:Name="SlmpRemotePasswordBox"
                         Grid.Row="7"
                         Grid.Column="1"
                         AutomationProperties.AutomationId="ConnectionSlmpRemotePasswordBox" />
          </Grid>
        </GroupBox>

        <GroupBox Header="Host Link" Visibility="{Binding IsHostLinkSelected, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,12">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="PLC profile" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      ItemsSource="{Binding HostLinkProfiles}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedHostLinkProfile}" />
          </Grid>
        </GroupBox>

        <GroupBox Header="TOYOPUC" Visibility="{Binding IsToyopucSelected, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Profile" VerticalAlignment="Center" Margin="0,0,8,8" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding ToyopucPlcProfiles}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedToyopucPlcProfile}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Relay hops" VerticalAlignment="Center" Margin="0,0,8,8" />
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
              <TextBox Text="{Binding ToyopucRelayHops}"
                       ToolTip="Example: P1-L1:N2" />
              <TextBlock Text="Example: P1-L1:N2"
                         Foreground="{DynamicResource AppForegroundMutedBrush}"
                         FontSize="12"
                         Margin="0,4,0,0" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Local port" VerticalAlignment="Center" Margin="0,0,8,8" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Text="{Binding ToyopucLocalPort}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Retries / delay ms" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
              <TextBox Width="120" Margin="0,0,8,0" Text="{Binding ToyopucRetries}" />
              <TextBox Width="120" Text="{Binding ToyopucRetryDelayMs}" />
            </StackPanel>
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
