<Window x:Class="PlcScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:PlcScope.App.Selectors"
        xmlns:vm="clr-namespace:PlcScope.App.ViewModels"
        mc:Ignorable="d"
        Title="PLC I/O モニター"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="720"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Background" Value="#3C3C3C" />
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="BorderBrush" Value="#555555" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BitButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Background" Value="#2A2A2A" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="BorderBrush" Value="#444444" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="#27AE60" />
          <Setter Property="Foreground" Value="White" />
          <Setter Property="BorderBrush" Value="#2ECC71" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BitCellTemplate" DataType="{x:Type vm:BitCellViewModel}">
      <Button Style="{StaticResource BitButtonStyle}"
              Command="{Binding ToggleCommand}"
              IsEnabled="{Binding CanToggle}"
              ToolTip="{Binding Address}"
              Content="{Binding BitIndex}" />
    </DataTemplate>

    <DataTemplate x:Key="WordRowTemplate" DataType="{x:Type vm:WordRowViewModel}">
      <Grid Margin="2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <TextBox Grid.Column="1"
                 Margin="4,0"
                 Background="#1E3A5C"
                 Foreground="#F0F0F0"
                 BorderBrush="#0E639C"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" VerticalAlignment="Center" Foreground="#CE9178" FontFamily="Consolas" />
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" VerticalAlignment="Center" Foreground="#6A9955" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PackedBitRowTemplate" DataType="{x:Type vm:PackedBitRowViewModel}">
      <Grid Margin="2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="2" Text="{Binding Comment}" VerticalAlignment="Center" Foreground="#6A9955" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SingleBitRowTemplate" DataType="{x:Type vm:SingleBitRowViewModel}">
      <Grid Margin="2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <Button Grid.Column="1" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource ToolbarButtonStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding ValueText}" VerticalAlignment="Center" Foreground="#DCDCAA" FontFamily="Consolas" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DWordRowTemplate" DataType="{x:Type vm:DWordRowViewModel}">
      <Grid Margin="2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <TextBox Grid.Column="1"
                 Margin="4,0"
                 Background="#1E3A5C"
                 Foreground="#F0F0F0"
                 BorderBrush="#0E639C"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" VerticalAlignment="Center" Foreground="#CE9178" FontFamily="Consolas" />
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" VerticalAlignment="Center" Foreground="#6A9955" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FloatRowTemplate" DataType="{x:Type vm:FloatRowViewModel}">
      <Grid Margin="2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <TextBox Grid.Column="1"
                 Margin="4,0"
                 Background="#1E3A5C"
                 Foreground="#F0F0F0"
                 BorderBrush="#0E639C"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" VerticalAlignment="Center" Foreground="#CE9178" FontFamily="Consolas" />
        <TextBlock Grid.Column="3" Text="{Binding Comment}" VerticalAlignment="Center" Foreground="#6A9955" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedHeaderTemplate" DataType="{x:Type vm:ExpandedWordHeaderRowViewModel}">
      <Grid Margin="2,6,2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9CDCFE" FontFamily="Consolas" />
        <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center" Foreground="#DCDCAA" FontFamily="Consolas" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" VerticalAlignment="Center" Foreground="#CE9178" FontFamily="Consolas" />
        <ItemsControl Grid.Column="3" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" VerticalAlignment="Center" Foreground="#6A9955" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedBitTemplate" DataType="{x:Type vm:ExpandedBitRowViewModel}">
      <Grid Margin="18,1,2,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="100" />
          <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" VerticalAlignment="Center" Foreground="#9CDCFE" FontFamily="Consolas" />
        <TextBlock Grid.Column="1" Text="{Binding BitIndex, StringFormat=b{0}}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource ToolbarButtonStyle}" />
        <TextBlock Grid.Column="3" Text="{Binding ValueText}" VerticalAlignment="Center" Foreground="#DCDCAA" FontFamily="Consolas" />
      </Grid>
    </DataTemplate>

    <selectors:MonitorRowTemplateSelector x:Key="MonitorRowTemplateSelector"
                                          WordTemplate="{StaticResource WordRowTemplate}"
                                          PackedBitsTemplate="{StaticResource PackedBitRowTemplate}"
                                          SingleBitTemplate="{StaticResource SingleBitRowTemplate}"
                                          DWordTemplate="{StaticResource DWordRowTemplate}"
                                          FloatTemplate="{StaticResource FloatRowTemplate}"
                                          ExpandedHeaderTemplate="{StaticResource ExpandedHeaderTemplate}"
                                          ExpandedBitTemplate="{StaticResource ExpandedBitTemplate}" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#252526" Foreground="#E0E0E0">
      <MenuItem Header="ファイル">
        <MenuItem Header="新規プロジェクト" Click="NewProjectMenuItem_Click" />
        <MenuItem Header="開く..." Click="OpenProjectMenuItem_Click" />
        <MenuItem Header="保存" Click="SaveProjectMenuItem_Click" />
        <MenuItem Header="名前を付けて保存..." Click="SaveProjectAsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="接続">
        <MenuItem Header="接続設定..." Click="ConnectionSettingsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="ツール">
        <MenuItem Header="通信ログ..." Click="TraceLogMenuItem_Click" />
        <MenuItem Header="エラー履歴..." Click="ErrorHistoryMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="ヘルプ">
        <MenuItem Header="バージョン情報" Click="AboutMenuItem_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom" Background="#252526" Foreground="#E0E0E0">
      <StatusBarItem Content="{Binding StatusText}" />
      <Separator />
      <StatusBarItem Content="{Binding LastReadText, StringFormat=最終読込: {0}}" />
      <Separator />
      <StatusBarItem Content="{Binding ResponseTimeText, StringFormat=応答: {0}}" />
      <Separator />
      <StatusBarItem Content="{Binding CpuStateText, StringFormat=CPU: {0}}" />
      <Separator />
      <StatusBarItem Content="{Binding ErrorText}" />
    </StatusBar>

    <StackPanel Margin="12">
      <Border Background="#252526" BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="接続設定..." Click="ConnectionSettingsMenuItem_Click" Style="{StaticResource ToolbarButtonStyle}" />
          <Button Content="接続" Command="{Binding ConnectCommand}" Style="{StaticResource ToolbarButtonStyle}" />
          <Button Content="切断" Command="{Binding DisconnectCommand}" Style="{StaticResource ToolbarButtonStyle}" />
          <Ellipse Width="12" Height="12" Margin="10,0,6,0">
            <Ellipse.Style>
              <Style TargetType="Ellipse">
                <Setter Property="Fill" Value="#808080" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                    <Setter Property="Fill" Value="#27AE60" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
                    <Setter Property="Fill" Value="#E74C3C" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Ellipse.Style>
          </Ellipse>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock Text="プロトコル" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox Width="240"
                    ItemsSource="{Binding AvailableProtocols}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedProtocol}" />
        </StackPanel>
      </Border>

      <Border Background="#2D2D2D" BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox Grid.Column="0"
                    Margin="0,0,6,0"
                    ItemsSource="{Binding AvailableDeviceFamilies}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedDeviceFamily}" />
          <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" />
          <TextBox Grid.Column="2" Margin="0,0,6,0" Text="{Binding ItemCount, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Grid.Column="3" Margin="0,0,6,0" ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding DisplayMode}" />
          <ComboBox Grid.Column="4" Margin="0,0,6,0" ItemsSource="{Binding BitDisplayModes}" SelectedItem="{Binding BitDisplayMode}" />
          <ComboBox Grid.Column="5" Margin="0,0,6,0" ItemsSource="{Binding DisplayRadices}" SelectedItem="{Binding DisplayRadix}" />
          <CheckBox Grid.Column="6" Margin="0,0,6,0" Content="自動更新" IsChecked="{Binding AutoRefreshEnabled}" VerticalAlignment="Center" />
          <TextBox Grid.Column="7" Margin="0,0,6,0" Text="{Binding AutoRefreshIntervalMs}" />
          <Button Grid.Column="8" Content="読込" Command="{Binding ReadOnceCommand}" IsEnabled="{Binding IsConnected}" Style="{StaticResource ToolbarButtonStyle}" />
          <TextBlock Grid.Column="9" Text="プロジェクト" VerticalAlignment="Center" Margin="8,0,4,0" />
          <TextBlock Grid.Column="10" Text="{Binding ProjectName}" VerticalAlignment="Center" Foreground="#DCDCAA" />
        </Grid>
      </Border>

      <Border Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1" Padding="8" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="アドレス" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="値" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="Hex" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="ビット" FontWeight="Bold" />
            <TextBlock Grid.Column="4" Text="コメント" FontWeight="Bold" />
          </Grid>

          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Rows}"
                   SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                   Background="#1F1F1F"
                   BorderThickness="0"
                   Foreground="#E0E0E0"
                   ItemTemplateSelector="{StaticResource MonitorRowTemplateSelector}" />
        </Grid>
      </Border>

      <Border Background="#252526" BorderBrush="#333333" BorderThickness="1" Padding="8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox Grid.Column="0" Margin="0,0,8,0" IsEnabled="{Binding CanUseWritePanel}" Text="{Binding WriteAddress, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Grid.Column="1" Margin="0,0,8,0" IsEnabled="{Binding CanUseWritePanel}" ItemsSource="{Binding ValueDataTypes}" SelectedItem="{Binding SelectedWriteDataType}" />
          <TextBox Grid.Column="2" Margin="0,0,8,0" IsEnabled="{Binding CanUseWritePanel}" Text="{Binding WriteValueText, UpdateSourceTrigger=PropertyChanged}" />
          <ComboBox Grid.Column="3" Margin="0,0,8,0" IsEnabled="{Binding CanUseWritePanel}" ItemsSource="{Binding DisplayRadices}" SelectedItem="{Binding WriteRadix}" />
          <Button Grid.Column="4" Content="書込み" Command="{Binding WritePanelCommand}" IsEnabled="{Binding CanUseWritePanel}" Style="{StaticResource ToolbarButtonStyle}" />
          <CheckBox Grid.Column="5" Content="書込みロック" IsChecked="{Binding WriteLockEnabled}" VerticalAlignment="Center" />
          <CheckBox Grid.Column="6" Content="確認" IsChecked="{Binding ConfirmBeforeWrite}" VerticalAlignment="Center" />
          <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="CPU RUN" Command="{Binding CpuRunCommand}" IsEnabled="{Binding CanIssueCpuControl}" ToolTip="{Binding CpuControlHint}" Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="CPU STOP" Command="{Binding CpuStopCommand}" IsEnabled="{Binding CanIssueCpuControl}" ToolTip="{Binding CpuControlHint}" Style="{StaticResource ToolbarButtonStyle}" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
