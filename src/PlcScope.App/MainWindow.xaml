<Window x:Class="PlcScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:PlcScope.App.Selectors"
        xmlns:vm="clr-namespace:PlcScope.App.ViewModels"
        mc:Ignorable="d"
        Title="PLC I/O Monitor"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="720"
        FontSize="{Binding SelectedFontSizeOption.Size}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="PrimaryToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style x:Key="FieldGroupStyle" TargetType="{x:Type StackPanel}">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="MonitorHeaderTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SectionTitleTextStyle}">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AddressTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppAddressBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppValueBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="HexTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppHexBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="CommentTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppCommentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="InlineValueTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource AppWriteInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="ToolTip" Value="Enter to write, Esc to cancel." />
      <EventSetter Event="PreviewMouseDown" Handler="InlineValueTextBox_PreviewMouseDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="InlineValueTextBox_GotKeyboardFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="InlineValueTextBox_LostKeyboardFocus" />
    </Style>

    <Style x:Key="BitButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyBitCellBorderStyle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanToggle}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyBitCellTextStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BitStateButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Value}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8,4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
          <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusDotStyle" TargetType="{x:Type Ellipse}">
      <Setter Property="Fill" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
          <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
          <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
          <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BitCellTemplate" DataType="{x:Type vm:BitCellViewModel}">
      <Grid>
        <Button Style="{StaticResource BitButtonStyle}"
                Command="{Binding ToggleCommand}"
                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                ToolTip="{Binding Address}"
                Content="{Binding Label}" />
        <Border Style="{StaticResource ReadOnlyBitCellBorderStyle}"
                ToolTip="{Binding Address}">
          <TextBlock Style="{StaticResource ReadOnlyBitCellTextStyle}"
                     Text="{Binding Label}" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WordRowTemplate" DataType="{x:Type vm:WordRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PackedBitRowTemplate" DataType="{x:Type vm:PackedBitRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <ItemsControl Grid.Column="1" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="2" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SingleBitRowTemplate" DataType="{x:Type vm:SingleBitRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <Button Grid.Column="1" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource BitStateButtonStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
        <TextBlock Grid.Column="3" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DWordRowTemplate" DataType="{x:Type vm:DWordRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FloatRowTemplate" DataType="{x:Type vm:FloatRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedHeaderTemplate" DataType="{x:Type vm:ExpandedWordHeaderRowViewModel}">
      <Grid MinHeight="34" Background="{DynamicResource AppHeaderBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" FontWeight="SemiBold" Style="{StaticResource AddressTextStyle}" />
        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedBitTemplate" DataType="{x:Type vm:ExpandedBitRowViewModel}">
      <Grid MinHeight="32" Margin="22,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBlock Grid.Column="1" Text="{Binding BitIndex, StringFormat=b{0}}" VerticalAlignment="Center" Margin="8,0" />
        <Button Grid.Column="2" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource BitStateButtonStyle}" />
        <TextBlock Grid.Column="3" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
      </Grid>
    </DataTemplate>

    <selectors:MonitorRowTemplateSelector x:Key="MonitorRowTemplateSelector"
                                          WordTemplate="{StaticResource WordRowTemplate}"
                                          PackedBitsTemplate="{StaticResource PackedBitRowTemplate}"
                                          SingleBitTemplate="{StaticResource SingleBitRowTemplate}"
                                          DWordTemplate="{StaticResource DWordRowTemplate}"
                                          FloatTemplate="{StaticResource FloatRowTemplate}"
                                          ExpandedHeaderTemplate="{StaticResource ExpandedHeaderTemplate}"
                                          ExpandedBitTemplate="{StaticResource ExpandedBitTemplate}" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="File">
        <MenuItem Header="New project" Click="NewProjectMenuItem_Click" />
        <MenuItem Header="Open" Click="OpenProjectMenuItem_Click" />
        <MenuItem Header="Import comment CSV" Click="ImportCommentCsvMenuItem_Click" />
        <MenuItem Header="Save" Click="SaveProjectMenuItem_Click" />
        <MenuItem Header="Save as" Click="SaveProjectAsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="Connection">
        <MenuItem Header="Connection settings" Click="ConnectionSettingsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="CPU">
        <MenuItem Header="Device ranges" Click="DeviceRangeMenuItem_Click" />
        <Separator />
        <MenuItem Header="CPU RUN"
                  Command="{Binding CpuRunCommand}"
                  IsEnabled="{Binding CanIssueCpuControl}"
                  ToolTip="{Binding CpuControlHint}" />
        <MenuItem Header="CPU STOP"
                  Command="{Binding CpuStopCommand}"
                  IsEnabled="{Binding CanIssueCpuControl}"
                  ToolTip="{Binding CpuControlHint}" />
      </MenuItem>
      <MenuItem Header="Tools">
        <MenuItem Header="Error history" Click="ErrorHistoryMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About" Click="AboutMenuItem_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding StatusText}" />
      <Separator />
      <StatusBarItem Content="{Binding LastReadText, StringFormat=Last read: {0}}" />
      <Separator />
      <StatusBarItem Content="{Binding CommunicationRateText, StringFormat=Traffic: {0}}" />
      <Separator />
      <StatusBarItem Content="{Binding CpuStateText, StringFormat=CPU: {0}}" />
      <Separator />
      <StatusBarItem>
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource AppDangerBrush}" TextTrimming="CharacterEllipsis" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Connection settings" Click="ConnectionSettingsMenuItem_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Configure PLC communication settings." />
            <Button Content="Connect" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryToolbarButtonStyle}" ToolTip="Connect with the selected settings." />
            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Disconnect from the PLC." />
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Margin="0,0,8,0" Style="{StaticResource StatusDotStyle}" />
              <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Project" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" Text="{Binding ProjectName}" Foreground="{DynamicResource AppValueBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Theme" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="88"
                      ItemsSource="{Binding ThemeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedThemeOption}"
                      ToolTip="Switch theme." />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Font" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="78"
                      ItemsSource="{Binding FontSizeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedFontSizeOption}"
                      ToolTip="Switch font size." />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
        <TabItem Header="Monitor">
          <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource AppInputBrush}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Background="{DynamicResource AppPanelAltBrush}" Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="138" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Device" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox ItemsSource="{Binding AvailableDeviceFamilies}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedDeviceFamily}"
                            PreviewMouseWheel="DeviceFamilyComboBox_PreviewMouseWheel"
                            ToolTip="Select the device family to monitor." />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Start address" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: D0 or X0." />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Type" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox ItemsSource="{Binding ValueDataTypes}" SelectedItem="{Binding MonitorDataType}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Format" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox ItemsSource="{Binding DisplayRadices}" SelectedItem="{Binding DisplayRadix}" />
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Background="{DynamicResource AppHeaderBrush}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="2" Text="Hex" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="3" Text="Bits" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="4" Text="Comment" Style="{StaticResource MonitorHeaderTextStyle}" />
              </Grid>

              <ListBox x:Name="MonitorListBox"
                       Grid.Row="2"
                       ItemsSource="{Binding Rows}"
                       SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       BorderThickness="0"
                       Loaded="MonitorListBox_Loaded"
                       Unloaded="MonitorListBox_Unloaded"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.ScrollUnit="Item"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ItemTemplateSelector="{StaticResource MonitorRowTemplateSelector}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="MonitorListBoxItem_PreviewMouseRightButtonDown" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Add to watch list"
                              Click="AddMonitorRowToWatchMenuItem_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="Watch list">
          <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource AppInputBrush}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <DataGrid x:Name="WatchDataGrid"
                        Grid.Row="0"
                        ItemsSource="{Binding WatchItems}"
                        SelectedItem="{Binding SelectedWatchItem, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal"
                        BorderThickness="0"
                        Background="{DynamicResource AppInputBrush}"
                        KeyDown="WatchDataGrid_KeyDown"
                        Loaded="WatchDataGrid_Loaded"
                        Unloaded="WatchDataGrid_Unloaded"
                        ScrollViewer.CanContentScroll="True"
                        EnableRowVirtualization="True"
                        EnableColumnVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Item"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Resources>
                  <Style TargetType="{x:Type DataGridRow}">
                    <Setter Property="MinHeight" Value="34" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="WatchDataGridRow_PreviewMouseRightButtonDown" />
                  </Style>
                  <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AppForegroundStrongBrush}" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.Resources>
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Remove" Click="RemoveWatchItemMenuItem_Click" />
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Address" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Address}" ToolTip="{Binding ErrorText}">
                          <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource AddressTextStyle}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                  <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Type" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DataType}" Style="{StaticResource ValueTextStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.ValueDataTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="WatchOptionComboBox_SelectionChanged" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Format" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayRadix}" Style="{StaticResource ValueTextStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <ComboBox ItemsSource="{Binding DataContext.DisplayRadices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                  SelectedItem="{Binding DisplayRadix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectionChanged="WatchOptionComboBox_SelectionChanged" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Value" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="WatchValueTextBox_GotKeyboardFocus"
                                 LostKeyboardFocus="WatchValueTextBox_LostKeyboardFocus"
                                 KeyDown="WatchValueTextBox_KeyDown" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Hex" IsReadOnly="True" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding RawText}" Style="{StaticResource HexTextStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Bits" Width="260">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel VerticalAlignment="Center" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                        </ItemsControl>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Comment" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                      <DataTemplate>
                        <TextBox Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>



