<Window x:Class="PlcScope.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:selectors="clr-namespace:PlcScope.App.Selectors"
        xmlns:vm="clr-namespace:PlcScope.App.ViewModels"
        mc:Ignorable="d"
        Title="PLC Scope"
        Width="1500"
        Height="920"
        MinWidth="1200"
        MinHeight="720"
        AutomationProperties.AutomationId="MainWindow"
        AutomationProperties.HelpText="{Binding UiAutomationStateText}"
        FontSize="{Binding SelectedFontSizeOption.Size}"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppForegroundBrush}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <Style x:Key="PanelBorderStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource AppPanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
    </Style>

    <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="10,4" />
    </Style>

    <Style x:Key="PrimaryToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButtonStyle}">
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="12,4" />
    </Style>

    <Style x:Key="FieldGroupStyle" TargetType="{x:Type StackPanel}">
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="MonitorHeaderTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SectionTitleTextStyle}">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AddressTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppAddressBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppValueBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="HexTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppHexBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style x:Key="CommentTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="{DynamicResource AppCommentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="InlineValueTextBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="AutomationProperties.AutomationId" Value="MonitorInlineValueTextBox" />
      <Setter Property="Margin" Value="8,2" />
      <Setter Property="Background" Value="{DynamicResource AppWriteInputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="HorizontalContentAlignment" Value="Right" />
      <Setter Property="ToolTip" Value="Enter to write, Esc to cancel." />
      <EventSetter Event="PreviewMouseDown" Handler="InlineValueTextBox_PreviewMouseDown" />
      <EventSetter Event="PreviewKeyDown" Handler="ValueTextBox_PreviewKeyDown" />
      <EventSetter Event="GotKeyboardFocus" Handler="InlineValueTextBox_GotKeyboardFocus" />
      <EventSetter Event="LostKeyboardFocus" Handler="InlineValueTextBox_LostKeyboardFocus" />
    </Style>

    <Style x:Key="BitButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyBitCellBorderStyle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="1" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanToggle}" Value="True">
          <Setter Property="Visibility" Value="Collapsed" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ReadOnlyBitCellTextStyle" TargetType="{x:Type TextBlock}">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="FontWeight" Value="SemiBold" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="BitStateButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="96" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="Background" Value="{DynamicResource AppBitOffBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBitOffBorderBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Value}" Value="True">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{DynamicResource AppPanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8,4" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
          <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
          <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource AppDangerSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="StatusDotStyle" TargetType="{x:Type Ellipse}">
      <Setter Property="Fill" Value="{DynamicResource AppForegroundMutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
          <Setter Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Connecting">
          <Setter Property="Fill" Value="{DynamicResource AppWarningBrush}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding ConnectionState}" Value="Error">
          <Setter Property="Fill" Value="{DynamicResource AppDangerBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="BitCellTemplate" DataType="{x:Type vm:BitCellViewModel}">
      <Grid>
        <Button Style="{StaticResource BitButtonStyle}"
                Command="{Binding ToggleCommand}"
                Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibilityConverter}}"
                ToolTip="{Binding Address}"
                Content="{Binding Label}" />
        <Border Style="{StaticResource ReadOnlyBitCellBorderStyle}"
                ToolTip="{Binding Address}">
          <TextBlock Style="{StaticResource ReadOnlyBitCellTextStyle}"
                     Text="{Binding Label}" />
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="WordRowTemplate" DataType="{x:Type vm:WordRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 AutomationProperties.AutomationId="MonitorInlineValueTextBox"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="PackedBitRowTemplate" DataType="{x:Type vm:PackedBitRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <ItemsControl Grid.Column="1" Grid.ColumnSpan="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SingleBitRowTemplate" DataType="{x:Type vm:SingleBitRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <Button Grid.Column="1" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource BitStateButtonStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DWordRowTemplate" DataType="{x:Type vm:DWordRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="150" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 AutomationProperties.AutomationId="MonitorInlineValueTextBox"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="FloatRowTemplate" DataType="{x:Type vm:FloatRowViewModel}">
      <Grid MinHeight="34">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="150" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" />
        <TextBox Grid.Column="1"
                 AutomationProperties.AutomationId="MonitorInlineValueTextBox"
                 Style="{StaticResource InlineValueTextBoxStyle}"
                 IsEnabled="{Binding CanEdit}"
                 Text="{Binding EditableValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="InlineValueTextBox_KeyDown" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedHeaderTemplate" DataType="{x:Type vm:ExpandedWordHeaderRowViewModel}">
      <Grid MinHeight="34" Background="{DynamicResource AppHeaderBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" FontWeight="SemiBold" Style="{StaticResource AddressTextStyle}" />
        <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
        <TextBlock Grid.Column="2" Text="{Binding HexText}" Style="{StaticResource HexTextStyle}" />
        <ItemsControl Grid.Column="3" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="4" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ExpandedBitTemplate" DataType="{x:Type vm:ExpandedBitRowViewModel}">
      <Grid MinHeight="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
          <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
          <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
          <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
          <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" AutomationProperties.AutomationId="MonitorRowAddressTextBlock" AutomationProperties.Name="{Binding Address}" Text="{Binding Address}" Style="{StaticResource AddressTextStyle}" Margin="22,0,0,0" />
        <Button Grid.Column="1" Content="{Binding StateText}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanToggle}" Style="{StaticResource BitStateButtonStyle}" />
        <TextBlock Grid.Column="3" Text="{Binding ValueText}" Style="{StaticResource ValueTextStyle}" />
      </Grid>
    </DataTemplate>

    <selectors:MonitorRowTemplateSelector x:Key="MonitorRowTemplateSelector"
                                          WordTemplate="{StaticResource WordRowTemplate}"
                                          PackedBitsTemplate="{StaticResource PackedBitRowTemplate}"
                                          SingleBitTemplate="{StaticResource SingleBitRowTemplate}"
                                          DWordTemplate="{StaticResource DWordRowTemplate}"
                                          FloatTemplate="{StaticResource FloatRowTemplate}"
                                          ExpandedHeaderTemplate="{StaticResource ExpandedHeaderTemplate}"
                                          ExpandedBitTemplate="{StaticResource ExpandedBitTemplate}" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top" AutomationProperties.AutomationId="MainMenu">
      <MenuItem Header="File" AutomationProperties.AutomationId="FileMenu">
        <MenuItem Header="New project" AutomationProperties.AutomationId="NewProjectMenuItem" Click="NewProjectMenuItem_Click" />
        <MenuItem Header="Open" AutomationProperties.AutomationId="OpenProjectMenuItem" Click="OpenProjectMenuItem_Click" />
        <MenuItem Header="Import comment CSV" AutomationProperties.AutomationId="ImportCommentCsvMenuItem" Click="ImportCommentCsvMenuItem_Click" />
        <MenuItem Header="Import watch list CSV" AutomationProperties.AutomationId="ImportWatchListCsvMenuItem" Click="ImportWatchListCsvMenuItem_Click" />
        <MenuItem Header="Export watch list CSV" AutomationProperties.AutomationId="ExportWatchListCsvMenuItem" Click="ExportWatchListCsvMenuItem_Click" />
        <MenuItem Header="Save" AutomationProperties.AutomationId="SaveProjectMenuItem" Click="SaveProjectMenuItem_Click" />
        <MenuItem Header="Save as" AutomationProperties.AutomationId="SaveProjectAsMenuItem" Click="SaveProjectAsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="Connection" AutomationProperties.AutomationId="ConnectionMenu">
        <MenuItem Header="Connection settings" AutomationProperties.AutomationId="ConnectionSettingsMenuItem" Click="ConnectionSettingsMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="View" AutomationProperties.AutomationId="ViewMenu">
        <MenuItem x:Name="AlwaysOnTopMenuItem"
                  AutomationProperties.AutomationId="AlwaysOnTopMenuItem"
                  AutomationProperties.Name="Always on top"
                  IsCheckable="True"
                  Click="AlwaysOnTopMenuItem_Click"
                  ToolTip="Keep PLC Scope above other windows.">
          <MenuItem.Header>
            <StackPanel Orientation="Horizontal">
              <Grid Width="14" Margin="0,0,6,0">
                <Path Data="M 1 4 L 4 7 L 9 1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Square"
                      StrokeEndLineCap="Square"
                      Stretch="Uniform"
                      Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type MenuItem}}, Converter={StaticResource BoolToVisibilityConverter}}" />
              </Grid>
              <TextBlock Text="Always on top" />
            </StackPanel>
          </MenuItem.Header>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="CPU" AutomationProperties.AutomationId="CpuMenu">
        <MenuItem Header="Device ranges" AutomationProperties.AutomationId="DeviceRangesMenuItem" Click="DeviceRangeMenuItem_Click" />
        <MenuItem Header="CPU RUN"
                  AutomationProperties.AutomationId="CpuRunMenuItem"
                  Command="{Binding CpuRunCommand}"
                  IsEnabled="{Binding CanIssueCpuControl}"
                  ToolTip="{Binding CpuControlHint}" />
        <MenuItem Header="CPU STOP"
                  AutomationProperties.AutomationId="CpuStopMenuItem"
                  Command="{Binding CpuStopCommand}"
                  IsEnabled="{Binding CanIssueCpuControl}"
                  ToolTip="{Binding CpuControlHint}" />
        <MenuItem Header="CPU PAUSE"
                  AutomationProperties.AutomationId="CpuPauseMenuItem"
                  Command="{Binding CpuPauseCommand}"
                  IsEnabled="{Binding CanIssueCpuPauseControl}"
                  Visibility="{Binding CanShowCpuPauseControl, Converter={StaticResource BoolToVisibilityConverter}}"
                  ToolTip="{Binding CpuPauseControlHint}" />
      </MenuItem>
      <MenuItem Header="Tools" AutomationProperties.AutomationId="ToolsMenu">
        <MenuItem Header="Trace log" AutomationProperties.AutomationId="TraceLogMenuItem" Click="TraceLogMenuItem_Click" />
        <MenuItem Header="Error history" AutomationProperties.AutomationId="ErrorHistoryMenuItem" Click="ErrorHistoryMenuItem_Click" />
      </MenuItem>
      <MenuItem Header="Help" AutomationProperties.AutomationId="HelpMenu">
        <MenuItem Header="About" AutomationProperties.AutomationId="AboutMenuItem" Click="AboutMenuItem_Click" />
      </MenuItem>
    </Menu>

    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.AutomationId="MainStatusBar">
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="SelectedPlcModelStatusText" Text="{Binding SelectedPlcModelText}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="LastReadStatusText" Text="{Binding LastReadText, StringFormat=Last read: {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="TrafficStatusText" Text="{Binding CommunicationRateText, StringFormat=Traffic: {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="CpuStatusText" Text="{Binding CpuStateText, StringFormat=CPU: {0}}" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock AutomationProperties.AutomationId="ErrorStatusText" Text="{Binding ErrorText}" Foreground="{DynamicResource AppDangerBrush}" TextTrimming="CharacterEllipsis" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Connection settings" AutomationProperties.AutomationId="ConnectionSettingsButton" Click="ConnectionSettingsMenuItem_Click" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Configure PLC communication settings." />
            <Button Content="{Binding ConnectionToggleText}"
                    AutomationProperties.AutomationId="ConnectionToggleButton"
                    Command="{Binding ToggleConnectionCommand}"
                    Style="{StaticResource PrimaryToolbarButtonStyle}"
                    ToolTip="{Binding ConnectionToggleToolTip}" />
          </StackPanel>

          <Border Grid.Column="1" Style="{StaticResource StatusPillStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,10,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="10" Height="10" Margin="0,0,8,0" Style="{StaticResource StatusDotStyle}" />
              <TextBlock AutomationProperties.AutomationId="ConnectionStatusText" Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Project" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBlock Grid.Column="1" AutomationProperties.AutomationId="ProjectNameTextBlock" Text="{Binding ProjectName}" Foreground="{DynamicResource AppValueBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock Text="Theme" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="88"
                      ItemsSource="{Binding ThemeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedThemeOption}"
                      ToolTip="Switch theme." />
          </StackPanel>

          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Font" Foreground="{DynamicResource AppForegroundMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Width="78"
                      ItemsSource="{Binding FontSizeOptions}"
                      DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedFontSizeOption}"
                      ToolTip="Switch font size." />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl Grid.Row="1" AutomationProperties.AutomationId="MainTabControl" SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
        <TabItem Header="Monitor" AutomationProperties.AutomationId="MonitorTab">
          <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource AppInputBrush}" Padding="0">
            <Grid Grid.IsSharedSizeScope="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid Grid.Row="0" Background="{DynamicResource AppPanelAltBrush}" Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="138" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="104" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Device" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox AutomationProperties.AutomationId="MonitorDeviceComboBox"
                            ItemsSource="{Binding AvailableDeviceFamilies}"
                            DisplayMemberPath="DisplayName"
                            SelectedItem="{Binding SelectedDeviceFamily}"
                            PreviewMouseWheel="DeviceFamilyComboBox_PreviewMouseWheel"
                            ToolTip="Select the device family to monitor." />
                </StackPanel>
                <StackPanel Grid.Column="2" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Start address" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox AutomationProperties.AutomationId="MonitorStartAddressTextBox"
                           Text="{Binding StartAddress, UpdateSourceTrigger=LostFocus}"
                           KeyDown="CommitTextBoxOnEnter_KeyDown"
                           ToolTip="Example: D0 or X0." />
                </StackPanel>
                <StackPanel Grid.Column="3" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Type" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox AutomationProperties.AutomationId="MonitorDataTypeComboBox" ItemsSource="{Binding ValueDataTypes}" SelectedItem="{Binding MonitorDataType}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Style="{StaticResource FieldGroupStyle}">
                  <TextBlock Text="Format" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox AutomationProperties.AutomationId="MonitorFormatComboBox" ItemsSource="{Binding DisplayRadices}" SelectedItem="{Binding DisplayRadix}" />
                </StackPanel>
              </Grid>

              <ScrollViewer x:Name="MonitorHeaderScrollViewer"
                            Grid.Row="1"
                            Background="{DynamicResource AppHeaderBrush}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="MonitorHeaderGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" SharedSizeGroup="MonitorAddressColumn" />
                  <ColumnDefinition Width="120" SharedSizeGroup="MonitorValueColumn" />
                  <ColumnDefinition Width="110" SharedSizeGroup="MonitorHexColumn" />
                  <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="MonitorBitsColumn" />
                  <ColumnDefinition Width="220" SharedSizeGroup="MonitorCommentColumn" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="Value" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="2" Text="Hex" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="3" Text="Bits" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="4" Text="Comment" Style="{StaticResource MonitorHeaderTextStyle}" />
                </Grid>
              </ScrollViewer>

              <ListBox x:Name="MonitorListBox"
                       AutomationProperties.AutomationId="MonitorListBox"
                       Grid.Row="2"
                       ItemsSource="{Binding Rows}"
                       SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                       BorderThickness="0"
                       Loaded="MonitorListBox_Loaded"
                       Unloaded="MonitorListBox_Unloaded"
                       ScrollViewer.HorizontalScrollBarVisibility="Visible"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.ScrollUnit="Item"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       ItemTemplateSelector="{StaticResource MonitorRowTemplateSelector}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="MonitorListBoxItem_PreviewMouseRightButtonDown" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Add to watch list"
                              AutomationProperties.AutomationId="AddMonitorRowToWatchMenuItem"
                              Click="AddMonitorRowToWatchMenuItem_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
              </ListBox>
            </Grid>
          </Border>
        </TabItem>

        <TabItem Header="Watch list" AutomationProperties.AutomationId="WatchTab">
          <Border Style="{StaticResource PanelBorderStyle}" Background="{DynamicResource AppInputBrush}" Padding="0">
            <Grid Grid.IsSharedSizeScope="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <ScrollViewer x:Name="WatchHeaderScrollViewer"
                            Grid.Row="0"
                            Background="{DynamicResource AppHeaderBrush}"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="WatchHeaderGrid">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" SharedSizeGroup="WatchAddressColumn" />
                  <ColumnDefinition Width="110" SharedSizeGroup="WatchTypeColumn" />
                  <ColumnDefinition Width="100" SharedSizeGroup="WatchFormatColumn" />
                  <ColumnDefinition Width="130" SharedSizeGroup="WatchValueColumn" />
                  <ColumnDefinition Width="110" SharedSizeGroup="WatchHexColumn" />
                  <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="WatchBitsColumn" />
                  <ColumnDefinition Width="220" SharedSizeGroup="WatchCommentColumn" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="1" Text="Type" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="2" Text="Format" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="3" Text="Value" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="4" Text="Hex" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="5" Text="Bits" Style="{StaticResource MonitorHeaderTextStyle}" />
                <TextBlock Grid.Column="6" Text="Comment" Style="{StaticResource MonitorHeaderTextStyle}" />
                </Grid>
              </ScrollViewer>

              <ListBox x:Name="WatchListBox"
                       AutomationProperties.AutomationId="WatchListBox"
                       Grid.Row="1"
                       AllowDrop="True"
                       ItemsSource="{Binding WatchItems}"
                       SelectedItem="{Binding SelectedWatchItem, Mode=TwoWay}"
                       BorderThickness="0"
                       Background="{DynamicResource AppInputBrush}"
                       PreviewMouseLeftButtonDown="WatchListBox_PreviewMouseLeftButtonDown"
                       PreviewMouseMove="WatchListBox_PreviewMouseMove"
                       DragOver="WatchListBox_DragOver"
                       Drop="WatchListBox_Drop"
                       KeyDown="WatchListBox_KeyDown"
                       Loaded="WatchListBox_Loaded"
                       Unloaded="WatchListBox_Unloaded"
                       ScrollViewer.HorizontalScrollBarVisibility="Visible"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.CanContentScroll="True"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.ScrollUnit="Item"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="WatchListBoxItem_PreviewMouseRightButtonDown" />
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Remove" AutomationProperties.AutomationId="RemoveWatchItemMenuItem" Click="RemoveWatchItemMenuItem_Click" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:WatchItemViewModel}">
                    <Grid MinHeight="34">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" SharedSizeGroup="WatchAddressColumn" />
                        <ColumnDefinition Width="110" SharedSizeGroup="WatchTypeColumn" />
                        <ColumnDefinition Width="100" SharedSizeGroup="WatchFormatColumn" />
                        <ColumnDefinition Width="130" SharedSizeGroup="WatchValueColumn" />
                        <ColumnDefinition Width="110" SharedSizeGroup="WatchHexColumn" />
                        <ColumnDefinition Width="Auto" MinWidth="260" SharedSizeGroup="WatchBitsColumn" />
                        <ColumnDefinition Width="220" SharedSizeGroup="WatchCommentColumn" />
                      </Grid.ColumnDefinitions>
                      <TextBox Grid.Column="0"
                               AutomationProperties.AutomationId="WatchAddressTextBox"
                               Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                               KeyDown="CommitTextBoxOnEnter_KeyDown"
                               ToolTip="{Binding ErrorText}" />
                      <ComboBox Grid.Column="1"
                                AutomationProperties.AutomationId="WatchTypeComboBox"
                                ItemsSource="{Binding AvailableDataTypes}"
                                SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseWheel="WatchOptionComboBox_PreviewMouseWheel"
                                SelectionChanged="WatchOptionComboBox_SelectionChanged" />
                      <ComboBox Grid.Column="2"
                                AutomationProperties.AutomationId="WatchFormatComboBox"
                                ItemsSource="{Binding DataContext.DisplayRadices, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                SelectedItem="{Binding DisplayRadix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseWheel="WatchOptionComboBox_PreviewMouseWheel"
                                SelectionChanged="WatchOptionComboBox_SelectionChanged" />
                      <TextBox Grid.Column="3"
                               AutomationProperties.AutomationId="WatchValueTextBox"
                               Margin="8,2"
                               Background="{DynamicResource AppWriteInputBrush}"
                               BorderBrush="{DynamicResource AppAccentBrush}"
                               FontFamily="Consolas"
                               HorizontalContentAlignment="Right"
                               Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                               GotKeyboardFocus="WatchValueTextBox_GotKeyboardFocus"
                               LostKeyboardFocus="WatchValueTextBox_LostKeyboardFocus"
                               TextChanged="WatchValueTextBox_TextChanged"
                               KeyDown="WatchValueTextBox_KeyDown" />
                      <TextBlock Grid.Column="4" Text="{Binding RawText}" Style="{StaticResource HexTextStyle}" />
                      <ItemsControl Grid.Column="5" Margin="8,0" ItemsSource="{Binding Bits}" ItemTemplate="{StaticResource BitCellTemplate}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock Grid.Column="6" Text="{Binding Comment}" Style="{StaticResource CommentTextStyle}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>



