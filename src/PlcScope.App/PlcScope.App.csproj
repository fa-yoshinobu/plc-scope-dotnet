<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>PlcScope</AssemblyName>
    <RootNamespace>PlcScope.App</RootNamespace>
    <Product>PLC Scope</Product>
    <Company>FA Labo</Company>
    <Authors>FA Labo(fa_yoshinobu)</Authors>
    <Copyright>FA Labo(fa_yoshinobu)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.7</Version>
    <AssemblyVersion>0.1.7.0</AssemblyVersion>
    <FileVersion>0.1.7.0</FileVersion>
    <AssemblyInformationalVersion>0.1.7</AssemblyInformationalVersion>
    <InformationalVersion>0.1.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <ApplicationIcon Condition="Exists('..\..\icon.ico')">..\..\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlcScope.Core\PlcScope.Core.csproj" />
    <ProjectReference Include="..\PlcScope.Infrastructure\PlcScope.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PlcComm.KvHostLink">
      <HintPath>..\..\lib\plc-comm\net9.0\PlcComm.KvHostLink.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\icon.ico" Link="icon.ico" Condition="Exists('..\..\icon.ico')" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" Link="LICENSE" LogicalName="PlcScope.App.LICENSE" Condition="Exists('..\..\LICENSE')" />
  </ItemGroup>
</Project>
